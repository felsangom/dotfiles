{
    "version": 2,
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "blocks": [{
        "type": "prompt",
        "alignment": "left",
        "segments": [{
            "foreground": "#bb9af7",
            "style": "plain",
            "template": "\ueb99 {{ .UserName }} on",
            "type": "session"
        }, {
            "foreground": "#9ece6a",
            "properties": {
                "folder_separator_icon": "/",
                "style": "full"
            },
            "style": "plain",
            "template": " \uf07b {{ .Path }} ",
            "type": "path"
        }]
    }, {
        "type": "prompt",
        "alignment": "left",
        "newline": true,
        "segments": [{
            "foreground": "#ff007c",
            "style": "plain",
            "template": "\uf071 ",
            "type": "root"
        }, {
            "foreground":  "#ff007c",
            "foreground_templates": [
                "{{if not .Root}}#ff9e64{{end}}"
            ],
            "style": "plain",
            "template": "{{if .Root }}#{{ else }}${{ end }} ",
            "type": "text"
        }]
    }]
}
